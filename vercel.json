{
  "name": "studycare-api",
  "functions": {
    "app/api/config/route.js": {
      "runtime": "edge"
    },
    "app/api/health/route.js": {
      "runtime": "edge"
    },
    "app/api/university/search/route.js": {
      "runtime": "edge"
    },
    "app/api/university/departments/search/route.js": {
      "runtime": "edge"
    },
    "app/api/schools/search/route.js": {
      "runtime": "edge"
    },
    "app/api/generate-section/route.js": {
      "runtime": "nodejs18.x",
      "memory": 1024
    },
    "app/api/generate-roadmap/route.js": {
      "runtime": "nodejs18.x",
      "memory": 1024
    },
    "app/api/university/majors/route.js": {
      "runtime": "nodejs18.x",
      "memory": 1024
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "OPENAI_API_KEY": "@openai-api-key"
    }
  }
}